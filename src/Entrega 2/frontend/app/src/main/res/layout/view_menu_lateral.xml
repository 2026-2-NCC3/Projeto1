<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuLateralCompleto"
    android:layout_width="323dp"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    
    
    

    <LinearLayout
        android:id="@+id/painelMenu"
        android:layout_width="265dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/green"
        android:orientation="vertical"
        android:paddingTop="125dp">

        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="32dp"
            android:text="PRÓXIMA ETAPA"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        
        <TextView
            android:id="@+id/opcaoInicio"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="26dp"
            android:paddingEnd="20dp"
            android:text="Início"
            android:fontFamily="@font/regular"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="18sp" />

        
        <TextView
            android:id="@+id/opcaoAgenda"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="26dp"
            android:paddingEnd="20dp"
            android:text="Agenda"
            android:fontFamily="@font/regular"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="18sp" />

        
        <TextView
            android:id="@+id/opcaoCursos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="26dp"
            android:paddingEnd="20dp"
            android:text="Meus cursos"
            android:fontFamily="@font/regular"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/opcaoHistorico"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="26dp"
            android:paddingEnd="20dp"
            android:text="Histórico de presenças"
            android:fontFamily="@font/regular"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="18sp" />

        
        <TextView
            android:id="@+id/opcaoPerfil"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="26dp"
            android:paddingEnd="20dp"
            android:text="Meu perfil"
            android:fontFamily="@font/regular"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="18sp" />


        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="26dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="26dp"
            android:layout_marginBottom="12dp"
            android:background="@color/white" />



        <TextView
            android:id="@+id/opcaoConfiguracoes"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="26dp"
            android:paddingEnd="20dp"
            android:text="Configurações"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        
        <TextView
            android:id="@+id/opcaoSair"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="26dp"
            android:paddingEnd="20dp"
            android:text="Sair"
            android:fontFamily="@font/regular"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="18sp" />

    </LinearLayout>

    
    
    
    

    <FrameLayout
        android:id="@+id/btnMenuLateral"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="255dp"
        android:layout_marginTop="105dp"
        android:background="@color/green">

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            
            <View
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:layout_marginBottom="6dp"
                android:background="#FFFFFF" />

            
            <View
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:layout_marginBottom="6dp"
                android:background="#FFFFFF" />

            
            <View
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:background="#FFFFFF" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>