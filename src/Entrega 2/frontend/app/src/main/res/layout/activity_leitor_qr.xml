<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/perfil_fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar presença"
            android:textColor="@color/perfil_roxo"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Curso da atividade"
            android:textColor="@color/perfil_texto"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spinnerCursoPresenca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAtualizarCursosLeitor"
            style="@style/PerfilBotao"
            android:text="Atualizar cursos" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLerQr"
            style="@style/PerfilBotao"
            android:text="Escanear QR Code" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Ou digite o código do aluno"
            android:textColor="@color/perfil_texto"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/campoCodigoAluno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="ALUNO-UUID"
            android:inputType="text"
            android:singleLine="true"
            android:minHeight="48dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrarManual"
            style="@style/PerfilBotao"
            android:text="Registrar manualmente" />

        <TextView
            android:id="@+id/txtResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityLiveRegion="polite"
            android:text="Carregando cursos..."
            android:textColor="@color/perfil_texto"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="É necessário entrar com uma conta de responsável autorizada."
            android:textColor="@color/perfil_texto_secundario"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoltarLeitor"
            style="@style/PerfilBotao"
            android:layout_marginTop="20dp"
            android:text="Voltar" />

    </LinearLayout>
</ScrollView>
