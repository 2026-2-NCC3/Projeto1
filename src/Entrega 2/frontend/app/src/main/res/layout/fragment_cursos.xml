<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cursos_fundo">

    <LinearLayout
        android:id="@+id/cabecalhoCursos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/fundo_cabecalho_cursos"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:letterSpacing="0.12"
            android:text="@string/cursos_marca"
            android:textColor="@color/perfil_amarelo"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTituloCursos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingStart="80dp"
            android:paddingEnd="24dp"
            android:text="@string/cursos_titulo"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtituloCursos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="80dp"
            android:paddingEnd="24dp"
            android:text="@string/cursos_subtitulo"
            android:textColor="@color/cursos_texto_cabecalho"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/acoesCursos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cabecalhoCursos">

        <TextView
            android:id="@+id/txtListaCursos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="@string/cursos_lista_titulo"
            android:textColor="@color/perfil_texto"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAtualizarCursos"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/cursos_atualizar"
            android:textAllCaps="false"
            android:textColor="@color/perfil_roxo"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_atualizar_cursos"
            app:iconSize="18dp"
            app:iconTint="@color/perfil_roxo"
            app:strokeColor="@color/perfil_borda" />

    </LinearLayout>

    <TextView
        android:id="@+id/txtStatusCursos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/perfil_texto_secundario"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/acoesCursos" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCursos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtStatusCursos" />

</androidx.constraintlayout.widget.ConstraintLayout>
