<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="perfil_fundo">#F7F5FC</color>
    <color name="perfil_roxo">#5824A0</color>
    <color name="perfil_verde">#51C403</color>
    <color name="perfil_amarelo">#EEC545</color>
    <color name="perfil_texto">#252134</color>
    <color name="perfil_texto_secundario">#625B71</color>
    <color name="perfil_borda">#E5DDF1</color>

    <string name="perfil_titulo">Meu perfil</string>
    <string name="perfil_subtitulo">Sua jornada começa com você.</string>
    <string name="perfil_dados">Meus dados</string>
    <string name="perfil_nome">Nome completo</string>
    <string name="perfil_email">E-mail</string>
    <string name="perfil_cpf">CPF</string>
    <string name="perfil_telefone">Telefone</string>
    <string name="perfil_nao_informado">Não informado</string>
    <string name="perfil_acessos">Acesso às atividades</string>
    <string name="perfil_qr">Meu QR Code</string>
    <string name="perfil_leitor">Ler QR Code</string>
    <string name="perfil_atualizar">Atualizar dados</string>
    <string name="perfil_voltar">Voltar</string>

    <style name="PerfilRotulo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textColor">@color/perfil_texto_secundario</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PerfilValor">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/perfil_texto</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:text">@string/perfil_nao_informado</item>
    </style>

    <style name="PerfilBotao" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/perfil_roxo</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
